# Copy this file to .env for local development values.

# MySQL container settings
MYSQL_DATABASE=portfolio_db
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=portfolio_pass
MYSQL_ROOT_PASSWORD=root_pass

# External API
MARKET_API_BASE_URL=https://c4rm9elh30.execute-api.us-east-1.amazonaws.com/default

# Live market data providers (required for live quotes/history to appear)
FINNHUB_API_KEY=your_finnhub_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Optional direct Spring overrides (usually not needed with docker-compose)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/portfolio_db
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=change_me

